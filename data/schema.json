{
  "schema_version": "2.0",
  "description": "Field registry for master_store_tennis_SSoT.json. Source of truth for match record structure. Rank fields removed per Director order 2026-08-18.",
  "fields": {
    "date": {"type": "string", "format": "YYYY-MM-DD or empty string for forensic_null", "required": true},
    "tournament": {"type": "string", "required": true, "note": "Exact source name, never altered/canonicalized"},
    "tier": {"type": "string", "enum": ["GS", "M1000", "ATP500", "ATP250", "WTA500", "WTA250"], "required": true},
    "round": {"type": "string", "enum": ["R128", "R64", "R32", "R16", "QF", "SF", "F"], "required": true},
    "surface": {"type": "string", "required": true},
    "indoor": {"type": "boolean", "required": true},
    "tour": {"type": "string", "enum": ["ATP", "WTA"], "required": true},
    "playerA": {"type": "string", "required": true, "note": "Exact source name, never altered/canonicalized"},
    "playerB": {"type": "string", "required": true, "note": "Exact source name, never altered/canonicalized"},
    "setsA": {"type": "integer", "required": true},
    "setsB": {"type": "integer", "required": true},
    "gamesA": {"type": "integer", "required": true},
    "gamesB": {"type": "integer", "required": true},
    "score": {"type": "string", "required": true},
    "bestOf": {"type": "integer", "required": true},
    "duration_min": {"type": "integer", "format": "minutes, empty string if unknown", "required": true},
    "retired": {"type": "boolean", "required": true},
    "walkover": {"type": "boolean", "required": true},
    "source": {"type": "string", "required": true},
    "status": {"type": "string", "required": true},
    "defaulted": {"type": "boolean", "required": true},
    "winner": {"type": "string", "enum": ["A", "B"], "required": true},
    "provenance": {"type": "object", "required": true, "note": "nested; sub-fields vary by row"},
    "edition_year": {"type": "string", "required": true}
  },
  "removed_fields": {
    "rankA": {"removed_date": "2026-08-18", "reason": "Director order: rank data not needed"},
    "rankB": {"removed_date": "2026-08-18", "reason": "Director order: rank data not needed"}
  }
}
